# Endereço da API do gerenciador de licenças, visto pelo navegador. Padrão: /api (o proxy do deploy encaminha).
# O gerenciador é o mesmo do ACTUSPro: o site manda X-Produto: actusprot em toda chamada.
VITE_API_URL=/api
# Contatos mostrados no site (em branco, não aparecem)
VITE_CONTATO_EMAIL=
VITE_CONTATO_WHATSAPP=
# Desenvolvimento: porta do "npm run dev" (padrão 5201; o site do ACTUSPro usa a 5180)
SITE_PORTA=5201
# Desenvolvimento: para onde o "npm run dev" encaminha o /api
API_PROXY_TARGET=http://127.0.0.1:3100
